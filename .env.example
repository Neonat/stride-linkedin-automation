# ── Supabase (data + auth) ────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy from Project Settings → API
# Use ONLY these variables server-side. Ignore any auto-injected POSTGRES_*,
# NEXT_PUBLIC_*, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY, etc.

SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose to the browser (RLS enforces access control)
SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — NEVER expose to the browser; server-side Python only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Agnes AI — generation (instruct) ─────────────────────────────────────────
# Used by: api/draft.py  api/profile.py
AGNES_AI_TOKEN=...
AGNES_MODEL=agnes-2.0-flash

# ── NVIDIA NIM — generation keys (now unused by generation, kept for reference) ──
# NVIDIA_API_CHAT_KEY=nvapi-...
# NVIDIA_CHAT_MODEL=google/gemma-4-31b-it

# ── NVIDIA NIM — safety (Nemotron classifier) ─────────────────────────────────
# Used by: api/safety_check.py  (never crossed with the chat key)
NVIDIA_API_SAFETY_KEY=nvapi-...
NVIDIA_SAFETY_MODEL=nvidia/nemotron-3-content-safety

# ── LinkedIn (publish) ────────────────────────────────────────────────────────
# OAuth 2.0 access token with r_liteprofile + w_member_social scopes
LINKEDIN_ACCESS_TOKEN=

# Your LinkedIn person URN — e.g. urn:li:person:AbCdEfGhIj
LINKEDIN_PERSON_URN=

# LinkedIn API version in YYYYMM format
LINKEDIN_API_VERSION=202606
