# ── Supabase (data + auth) ────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy from Project Settings → API

# Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — safe to use in the frontend (RLS enforces access control)
SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — NEVER expose to the browser; server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── NVIDIA NIM (draft generation) ────────────────────────────────────────────
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# Generative instruction model served by NVIDIA NIM.
# Default: nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ── LinkedIn (publish) ────────────────────────────────────────────────────────
# OAuth 2.0 access token with r_liteprofile + w_member_social scopes
LINKEDIN_ACCESS_TOKEN=

# Your LinkedIn person URN — e.g. urn:li:person:AbCdEfGhIj
LINKEDIN_PERSON_URN=

# LinkedIn API version in YYYYMM format
# Check https://learn.microsoft.com/en-us/linkedin/shared/api-guide/versioning
LINKEDIN_API_VERSION=202501
